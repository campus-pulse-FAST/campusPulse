FROM oven/bun:1.1.42
WORKDIR /app

# Install ALL service dependencies in one shot
# This base image is shared by all services
RUN bun init -y && \
    bun add \
    @nestjs/common@^10.0.0 \
    @nestjs/core@^10.0.0 \
    @nestjs/platform-express@^10.0.0 \
    @nestjs/config@^3.0.0 \
    @nestjs/typeorm@^10.0.0 \
    @nestjs/jwt@^10.0.0 \
    @nestjs/passport@^10.0.0 \
    @nestjs/axios@^3.0.0 \
    @nestjs/schedule@^4.0.0 \
    typeorm@^0.3.0 \
    pg@^8.12.0 \
    axios@^1.7.0 \
    bcrypt@^5.1.0 \
    passport@^0.7.0 \
    passport-jwt@^4.0.0 \
    class-validator@^0.14.0 \
    class-transformer@^0.5.1 \
    reflect-metadata@^0.2.0 \
    rxjs@^7.8.0 \
    csv-parse@^5.5.0 \
    json2csv@^5.0.0 \
    multer@^1.4.0 \
    express@^4.21.0
